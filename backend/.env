# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA suba o arquivo ".env" (com valores reais) para o Git.

# Connection string do Postgres do Supabase.
# Encontre em: Supabase > Project Settings > Database > Connection string (URI)
# Formato: postgresql://postgres.mfssfvwtmfwbnwcpnmvn:sG6LIqa2EO5QKFs0!@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.mfssfvwtmfwbnwcpnmvn:sG6LIqa2EO5QKFs0@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Chave secreta usada para assinar os tokens JWT de login.
# Gere uma nova com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=bf119a4d29c479e72400cc6c69e92aa32cf191a38b19707b4bf77f1d374870ca

# URL(s) do frontend publicado, separadas por vírgula, sem barra no final.
# Ex: https://catolichord-plus.vercel.app
ALLOWED_ORIGINS=http://localhost:6543

